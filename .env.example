# =============================================================================
# SENKAI // DTF TEXTILE STUDIO - VARIABLES DE ENTORNO
# =============================================================================

# Entorno de ejecución: 'development' | 'staging' | 'production'
# En 'production', se activan validaciones estrictas de seguridad (CORS estricto y clave secreta obligatoria).
ENVIRONMENT=development

# Token criptográfico de seguridad para el portal de taller y endpoints administrativos.
# En producción, genera una clave aleatoria de 64 caracteres con: openssl rand -hex 32
# (El backend rechazará el arranque en producción si se utiliza la clave por defecto).
WORKSHOP_SECRET_KEY=senkai-taller-secret-key-2026

# Base de datos relacional:
# - Desarrollo/Staging: sqlite+aiosqlite:///./senkai_studio.db (concurrencia optimizada vía PRAGMA WAL)
# - Producción de alta concurrencia: postgresql+asyncpg://usuario:password@localhost:5432/senkai_db
DATABASE_URL=sqlite+aiosqlite:///./senkai_studio.db

# Orígenes autorizados para CORS (en producción, define explícitamente los dominios finales)
# Formato JSON lista de strings: '["https://senkai.cl", "https://www.senkai.cl"]'
# ALLOWED_ORIGINS='["https://senkai.cl", "https://www.senkai.cl"]'

# Endurecimiento y Rate Limiting por IP (peticiones por minuto)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ORDERS_PER_MINUTE=20
RATE_LIMIT_QUOTES_PER_MINUTE=150
RATE_LIMIT_UPLOADS_PER_MINUTE=30

# Identidad del proyecto
PROJECT_NAME="SENKAI // DTF Textile Studio"
VERSION=1.0.0
